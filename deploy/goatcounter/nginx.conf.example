# Add this inside the TLS server block for your chosen analytics hostname.
# The proxy must be attached to the infra Docker network.
location / {
    proxy_pass http://goatcounter:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Overwrite client-supplied forwarding headers at the public edge.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    # Count requests may contain campaign tags; do not log their query strings.
    access_log off;
}
