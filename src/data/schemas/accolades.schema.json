{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Accolades",
	"type": "array",
	"items": {
		"type": "object",
		"additionalProperties": false,
		"required": ["id", "date", "name", "certification", "link"],
		"properties": {
			"id": { "type": "integer", "minimum": 1, "x-hidden": true },
			"date": {
				"type": "string",
				"pattern": "^[0-9]{1,2}/[0-9]{1,2}/[0-9]{4}$",
				"x-hint": "M/D/YYYY"
			},
			"name": { "type": "string", "minLength": 1, "maxLength": 80 },
			"certification": {
				"type": "string",
				"minLength": 1,
				"maxLength": 80
			},
			"link": { "type": "string", "pattern": "^https://" }
		}
	}
}
