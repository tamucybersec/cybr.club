{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Photos",
	"type": "array",
	"items": {
		"type": "object",
		"additionalProperties": false,
		"required": ["id", "title", "description", "path"],
		"properties": {
			"id": {
				"type": "string",
				"pattern": "^[a-zA-Z][a-zA-Z0-9]*$",
				"x-hint": "Short unique name. Code may reference it; do not change an existing one."
			},
			"title": {
				"type": "string",
				"minLength": 1,
				"maxLength": 80
			},
			"description": {
				"type": "string",
				"minLength": 1,
				"maxLength": 120
			},
			"path": {
				"type": "string",
				"pattern": "^/images/[A-Za-z0-9._/-]+$"
			},
			"embelishment": {
				"type": "string"
			}
		}
	}
}
