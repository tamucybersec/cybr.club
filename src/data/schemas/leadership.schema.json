{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Leadership",
	"type": "array",
	"items": {
		"type": "object",
		"additionalProperties": false,
		"required": ["id", "name", "image", "major", "roles"],
		"properties": {
			"id": { "type": "integer", "minimum": 1, "x-hidden": true },
			"name": { "type": "string", "minLength": 1, "maxLength": 80 },
			"image": {
				"type": "string",
				"pattern": "^/images/[A-Za-z0-9._/-]+$"
			},
			"imageMode": { "enum": ["cover", "contain", "icon"] },
			"major": { "type": "string", "minLength": 1, "maxLength": 40 },
			"year": { "type": "integer", "minimum": 2000, "maximum": 2100 },
			"socials": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"email": { "type": "string", "format": "email" },
					"github": { "type": "string", "pattern": "^https://" },
					"linkedin": { "type": "string", "pattern": "^https://" },
					"website": { "type": "string", "pattern": "^https://" }
				}
			},
			"roles": {
				"type": "array",
				"minItems": 1,
				"items": {
					"type": "object",
					"additionalProperties": false,
					"required": ["title", "section"],
					"properties": {
						"title": {
							"type": "string",
							"minLength": 1,
							"maxLength": 80
						},
						"section": {
							"type": "string",
							"minLength": 1,
							"maxLength": 40
						}
					}
				}
			}
		}
	}
}
