{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Committees",
	"type": "array",
	"items": {
		"type": "object",
		"additionalProperties": false,
		"required": ["id", "title", "description", "image", "application"],
		"properties": {
			"id": { "type": "integer", "minimum": 1, "x-hidden": true },
			"title": { "type": "string", "minLength": 1, "maxLength": 100 },
			"description": {
				"type": "string",
				"minLength": 1,
				"maxLength": 800
			},
			"image": {
				"type": "string",
				"pattern": "^/images/[A-Za-z0-9._/-]+$"
			},
			"application": { "type": "string", "pattern": "^https://" }
		}
	}
}
